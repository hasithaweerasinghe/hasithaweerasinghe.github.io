---
import { projects, socials } from '../data/profile';

type Command = { group: string; label: string; hint?: string; href?: string; action?: string; external?: boolean };

const commands: Command[] = [
  { group: 'Navigate', label: 'Home', href: '#top' },
  { group: 'Navigate', label: 'About', href: '#about' },
  { group: 'Navigate', label: 'Selected work', href: '#work' },
  { group: 'Navigate', label: 'Open source', href: '#open-source' },
  { group: 'Navigate', label: 'Contact', href: '#contact' },
  ...projects.flatMap((p) =>
    p.links.slice(0, 1).map((l) => ({ group: 'Projects', label: p.title, hint: p.kind, href: l.href, external: true })),
  ),
  ...socials.map((s) => ({ group: 'Links', label: s.label, hint: s.handle, href: s.href, external: true })),
  { group: 'Actions', label: 'Toggle theme', action: 'theme' },
  { group: 'Actions', label: 'Copy link to this site', action: 'copy' },
];
---

<dialog class="palette" data-palette aria-label="Command menu">
  <div class="search">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    <input
      type="text"
      placeholder="Type a command or search…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      data-palette-input
    />
    <span class="kbd">esc</span>
  </div>
  <ul id="palette-list" role="listbox" data-palette-list>
    {commands.map((c, i) => (
      <li
        id={`cmd-${i}`}
        role="option"
        aria-selected="false"
        data-group={c.group}
        data-href={c.href}
        data-action={c.action}
        data-external={c.external ? '' : undefined}
      >
        <span class="group mono">{c.group}</span>
        <span class="label">{c.label}</span>
        {c.hint && <span class="hint mono">{c.hint}</span>}
      </li>
    ))}
  </ul>
  <p class="empty mono" data-palette-empty hidden>No results.</p>
  <p class="toast mono" data-palette-toast role="status"></p>
</dialog>

<style>
  .palette {
    width: min(100% - 32px, 600px);
    max-height: min(70vh, 520px);
    margin: 14vh auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
    box-shadow: 0 40px 120px -20px oklch(0% 0 0 / 0.45);
    overflow: hidden;
    flex-direction: column;

    &[open] { display: flex; }

    &::backdrop {
      background: oklch(10% 0 0 / 0.4);
      backdrop-filter: blur(6px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .palette[open] { animation: pop 0.28s var(--ease-out); }
    .palette[open]::backdrop { animation: fade 0.28s ease; }
  }

  @keyframes pop { from { opacity: 0; transform: translateY(-10px) scale(0.98); } }
  @keyframes fade { from { opacity: 0; } }

  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);

    & input {
      flex: 1;
      min-width: 0;
      height: 58px;
      border: 0;
      background: transparent;
      color: var(--text);
      font: 1.05rem var(--font-sans);
      outline: none;
    }
  }

  ul {
    margin: 0;
    padding: 8px;
    list-style: none;
    overflow-y: auto;
  }

  li {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius: 12px;
    cursor: pointer;

    &[aria-selected='true'] { background: color-mix(in oklch, var(--accent) 16%, transparent); }
    &[aria-selected='true'] .label { color: var(--accent-text); }
    &[hidden] { display: none; }
  }

  .group { color: var(--faint); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .label { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hint { color: var(--faint); font-size: 0.75rem; }

  .empty { margin: 0; padding: 28px; text-align: center; color: var(--faint); }

  .toast {
    margin: 0;
    padding: 0 18px;
    max-height: 0;
    overflow: hidden;
    color: var(--accent-text);
    transition: max-height 0.2s, padding 0.2s;
    &:not(:empty) { max-height: 40px; padding: 10px 18px; border-top: 1px solid var(--line); }
  }

  @media (max-width: 520px) {
    li { grid-template-columns: minmax(0, 1fr) auto; }
    .group { display: none; }
  }
</style>
