---
import { profile, socials } from '../data/profile';

const github = socials.find((s) => s.label === 'GitHub');
---

<section class="hero" id="top" data-hero>
  <canvas class="field" data-field aria-hidden="true"></canvas>
  <div class="glow" aria-hidden="true"></div>

  <div class="container content">
    {profile.openToWork ? (
      <a class="prompt mono open" href="#contact">
        <span class="status" aria-hidden="true"></span>
        Open to opportunities
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    ) : (
      <p class="prompt mono">
        <span class="status" aria-hidden="true"></span>
        <span class="faint">~/</span>{profile.role.toLowerCase().replaceAll(' ', '-')}
      </p>
    )}

    <h1>
      <span class="first">{profile.name.first}</span>
      <span class="last serif">{profile.name.last}</span>
    </h1>

    <p class="tagline">{profile.tagline}</p>

    <p class="typer mono" aria-live="off">
      <span class="faint">&gt;</span> currently exploring{' '}
      <span class="typed" data-typed data-phrases={JSON.stringify(profile.exploring)}>{profile.exploring[0]}</span><span class="caret" aria-hidden="true"></span>
    </p>

    <div class="ctas">
      <a class="btn primary" href="#work">See my work <span class="arrow" aria-hidden="true">→</span></a>
      {github && <a class="btn" href={github.href} target="_blank" rel="noopener">GitHub <span class="arrow" aria-hidden="true">↗</span></a>}
    </div>
  </div>

  <a class="scroll-hint mono" href="#about" aria-label="Scroll to about">
    <span>scroll</span>
    <span class="line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: 120px 96px;
    isolation: isolate;
    overflow: hidden;
  }

  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    color: var(--dot);
    /* Read by the canvas script for the "hot" dots near the cursor. */
    outline-color: var(--accent-text);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 40%, transparent 100%);
  }

  .glow {
    position: absolute;
    z-index: -2;
    width: 60vmax;
    aspect-ratio: 1;
    right: -20vmax;
    top: -25vmax;
    border-radius: 50%;
    background: radial-gradient(circle, var(--glow), transparent 65%);
    filter: blur(20px);
  }

  .prompt {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 6px 14px 6px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklch, var(--bg-raised) 70%, transparent);
    color: var(--muted);
  }

  .prompt.open {
    color: var(--text);
    text-decoration: none;
    border-color: color-mix(in oklch, var(--accent-text) 40%, var(--line));
    transition: border-color 0.2s, background-color 0.2s;

    & .arrow { color: var(--accent-text); transition: transform 0.3s var(--ease-out); }

    &:hover {
      border-color: var(--accent-text);
      background: color-mix(in oklch, var(--accent) 10%, var(--bg-raised));
      & .arrow { transform: translateX(3px); }
    }
  }

  .status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s infinite;
  }

  @keyframes pulse {
    70% { box-shadow: 0 0 0 8px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .faint { color: var(--faint); }

  h1 {
    margin: 0;
    font-size: clamp(3.4rem, 12.5vw, 10rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    font-weight: 700;

    & span { display: block; }

    & .last {
      color: var(--accent-text);
      font-size: 1.08em;
      letter-spacing: -0.03em;
      padding-left: 0.04em;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    h1 span, .tagline, .typer, .ctas, .prompt {
      animation: rise 1s var(--ease-out) both;
    }
    .prompt { animation-delay: 0.05s; }
    h1 .first { animation-delay: 0.12s; }
    h1 .last { animation-delay: 0.22s; }
    .tagline { animation-delay: 0.36s; }
    .typer { animation-delay: 0.46s; }
    .ctas { animation-delay: 0.56s; }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(28px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  .tagline {
    max-width: 34ch;
    margin: 32px 0 0;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }

  .typer {
    margin: 20px 0 0;
    color: var(--muted);
    min-height: 1.6em;
  }

  .typed { color: var(--text); }

  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 8px;
    color: var(--faint);
    text-decoration: none;

    & .line {
      width: 1px;
      height: 40px;
      background: linear-gradient(var(--faint), transparent);
      transform-origin: top;
      animation: drip 2.2s var(--ease-out) infinite;
    }
  }

  @keyframes drip {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media (max-height: 640px) {
    .scroll-hint { display: none; }
  }
</style>
