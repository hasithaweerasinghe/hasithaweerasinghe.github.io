---
const links = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '#open-source', label: 'Open source' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav" data-nav>
  <div class="container inner">
    <a href="#top" class="logo" aria-label="Back to top">hw<span>.</span></a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href} data-nav-link>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <button class="icon-btn palette-btn" type="button" data-palette-open aria-label="Open command menu">
        <span class="kbd" data-mod-key>⌘K</span>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle colour theme">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></g></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" /></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background-color 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;

    &.scrolled {
      background: color-mix(in oklch, var(--bg) 72%, transparent);
      backdrop-filter: blur(14px) saturate(1.4);
      border-color: var(--line);
    }
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 68px;
  }

  .logo {
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.06em;
    text-decoration: none;
    & span { color: var(--accent-text); }
  }

  ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 4px;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklch, var(--bg-raised) 60%, transparent);
  }

  nav a {
    display: block;
    padding: 6px 14px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;

    &:hover { color: var(--text); }
    &[aria-current='true'] { color: var(--accent-ink); background: var(--accent); }
  }

  .actions { display: flex; gap: 8px; }

  .icon-btn {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s;
    &:hover { border-color: var(--text); }
    & .kbd { border: 0; padding: 0; color: inherit; }
  }

  .moon { display: none; }
  :global(:root[data-theme='light']) .sun,
  :global(:root:not([data-theme])) .sun { display: none; }
  :global(:root[data-theme='light']) .moon,
  :global(:root:not([data-theme])) .moon { display: block; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .sun { display: block; }
    :global(:root:not([data-theme])) .moon { display: none; }
  }

  @media (max-width: 760px) {
    nav { display: none; }
  }
</style>
