---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Page not found">
  <main id="main" class="container">
    <p class="mono code">error 404</p>
    <h1>This page wandered <span class="serif">off.</span></h1>
    <a class="btn primary" href="/">Take me home <span class="arrow" aria-hidden="true">→</span></a>
  </main>
</Base>

<style>
  main {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 28px;
  }

  .code { margin: 0; color: var(--accent-text); }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    & .serif { color: var(--accent-text); }
  }
</style>
